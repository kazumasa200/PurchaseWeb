@page "/productmanage"
@implements IDisposable

<PageTitle>商品管理</PageTitle>

@if (IsLoading)
{
    <MudContainer Class="d-flex justify-center align-center" Style="min-height: 50vh;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </MudContainer>
}
else if (!UserState.IsStoreUser)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">
                ログインしてください
            </MudText>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth OnClick="NavigateToLogin">
                ログイン
            </MudButton>
        </MudPaper>
    </MudContainer>
}
else if (!UserState.HasTenant)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">
                テナントを選択してください
            </MudText>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth OnClick="NavigateToLogin">
                テナント選択
            </MudButton>
        </MudPaper>
    </MudContainer>
}
else
{
    <div class="product-manage-header">
        <MudContainer Class="py-4">
            <div class="d-flex justify-space-between align-center">
                <h1 class="mb-0">商品管理</h1>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                          StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
                    新規商品
                </MudButton>
            </div>
        </MudContainer>
    </div>

    <MudContainer Class="mt-4">
        <MudPaper Elevation="1" Class="pa-3">
            <div class="d-flex gap-3 align-center">
                <MudTextField @bind-Value="SearchText" Placeholder="商品名で検索..."
                              Variant="Variant.Outlined" Adornment="Adornment.Start"
                              Icon="@Icons.Material.Filled.Search"
                              Style="max-width: 300px;" Immediate="true" Clearable="true" />
                <MudChip T="string" Text="@($"{FilteredProducts.Count} 件")" Color="Color.Primary" Variant="Variant.Outlined" />
            </div>
        </MudPaper>

        @if (FilteredProducts.Any())
        {
            <div class="product-list mt-4">
                @foreach (var product in FilteredProducts)
                {
                    <MudCard Class="product-card mb-2" Elevation="2">
                        <MudCardContent>
                            <div class="d-flex gap-3 align-start">
                                <div class="product-image-wrapper" style="width: 200px; flex-shrink: 0;">
                                    @if (!IsImageLoaded(product.ProductId))
                                    {
                                        <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                                                     Width="200px" Height="200px"
                                                     Style="border-radius: 8px;" />
                                    }
                                    else if (!string.IsNullOrEmpty(GetProductImageSrc(product.ProductId)))
                                    {
                                        <img src="@GetProductImageSrc(product.ProductId)"
                                             alt="@product.ProductName"
                                             style="width: 200px; object-fit: cover; border-radius: 8px;" />
                                    }
                                    else
                                    {
                                        <div class="product-placeholder" style="width: 200px; height: 200px; display: flex; align-items: center; justify-content: center; background: #f5f5f5; border-radius: 8px;">
                                            <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Medium" Color="Color.Secondary" />
                                        </div>
                                    }
                                </div>

                                <div class="flex-grow-1">
                                    <div class="d-flex justify-space-between align-start mb-2">
                                        <MudText Typo="Typo.h6" Class="product-name">@product.ProductName</MudText>
                                        <MudChip T="string" Text="@GetStockText(product.StockQuantity)"
                                                 Color="@GetStockColor(product.StockQuantity)"
                                                 Size="Size.Small" Variant="Variant.Filled" />
                                    </div>

                                    <MudText Typo="Typo.body1" Color="Color.Primary" Class="product-price">
                                        @(product.Price) 円
                                    </MudText>

                                    @if (!string.IsNullOrEmpty(product.Misc))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                            @product.Misc
                                        </MudText>
                                    }

                                    <div class="d-flex gap-2 mt-3 pt-3 border-top">
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                                   Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit"
                                                   OnClick="() => OpenEditDialog(product)">
                                            編集
                                        </MudButton>
                                        <MudButton Variant="Variant.Text" Color="Color.Error"
                                                   Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete"
                                                   OnClick="() => ConfirmDelete(product)">
                                            削除
                                        </MudButton>
                                    </div>
                                </div>
                            </div>
                        </MudCardContent>
                    </MudCard>
                }
            </div>
        }
        else
        {
            <MudPaper Elevation="1" Class="pa-8 text-center mt-4">
                <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6" Class="mt-3">商品が見つかりません</MudText>
            </MudPaper>
        }
    </MudContainer>
}
