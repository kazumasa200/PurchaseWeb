@page "/purchasehistory"
@implements IDisposable

<PageTitle>購入履歴</PageTitle>

@if (IsLoading)
{
    <MudContainer Class="d-flex justify-center align-center" Style="min-height: 50vh;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </MudContainer>
}
else if (!UserState.IsStoreUser)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">
                ログインしてください
            </MudText>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth OnClick="NavigateToLogin">
                ログイン
            </MudButton>
        </MudPaper>
    </MudContainer>
}
else if (!UserState.HasTenant)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">
                テナントを選択してください
            </MudText>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth OnClick="NavigateToLogin">
                テナント選択
            </MudButton>
        </MudPaper>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
        <MudText Typo="Typo.h4" Class="mb-4">購入履歴</MudText>

        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.h5" Color="Color.Primary">総売上</MudText>
                    <MudText Typo="Typo.h3">@ProductSummaries.Sum(s => s.TotalSales).ToString("N0") 円</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.h5" Color="Color.Secondary">総取引件数</MudText>
                    <MudText Typo="Typo.h3">@PurchaseLogs.Count 件</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.h5" Color="Color.Tertiary">総販売個数</MudText>
                    <MudText Typo="Typo.h3">@PurchaseLogs.Sum(log => log.Amount) 個</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudText Typo="Typo.h5" Class="mb-2">商品別売上集計</MudText>
        <MudDataGrid Items="@ProductSummaries" ReadOnly="true" Bordered="true" Dense="true" SortMode="SortMode.Multiple" Class="mb-6">
            <Columns>
                <PropertyColumn Property="x => x.ProductName" Title="商品名" Sortable="true" />
                <PropertyColumn Property="x => x.Price" Title="単価" Format="N0" Sortable="true">
                    <CellTemplate>@context.Item.Price 円</CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.TotalAmount" Title="総販売数" Format="N0" Sortable="true" InitialDirection="SortDirection.Descending">
                    <CellTemplate>@context.Item.TotalAmount 個</CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.TotalSales" Title="売上合計" Format="N0" Sortable="true">
                    <CellTemplate>
                        <MudText Typo="Typo.body1" Style="font-weight: bold;">@context.Item.TotalSales.ToString("N0") 円</MudText>
                    </CellTemplate>
                </PropertyColumn>
                <TemplateColumn Title="状態" Sortable="true">
                    <CellTemplate>
                        @if (context.Item.IsDeleted)
                        {
                            <MudChip Color="Color.Error" Size="Size.Small">削除済み</MudChip>
                        }
                        else
                        {
                            <MudChip Color="Color.Success" Size="Size.Small">販売中</MudChip>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>

        <MudText Typo="Typo.h5" Class="mb-2">購入ログ詳細</MudText>
        @if (PurchaseLogs.Any())
        {
            <MudDataGrid Items="@PurchaseLogs" ReadOnly="true" Bordered="true" Dense="true"
                         Virtualize="true" FixedHeader="true" Height="50vh" SortMode="SortMode.Multiple">
                <Columns>
                    <PropertyColumn Property="x => x.PurchaseDate" Title="購入日時" Format="yyyy/MM/dd HH:mm:ss" Sortable="true" InitialDirection="SortDirection.Descending" />
                    <TemplateColumn Title="商品名" Sortable="false">
                        <CellTemplate>@GetProductName(context.Item.ProductId)</CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.Amount" Title="数量" Sortable="true">
                        <CellTemplate>@context.Item.Amount 個</CellTemplate>
                    </PropertyColumn>
                    <TemplateColumn Title="単価" Sortable="false">
                        <CellTemplate>@GetProductPrice(context.Item.ProductId) 円</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="合計金額" Sortable="false">
                        <CellTemplate>@(context.Item.Amount * GetProductPrice(context.Item.ProductId)) 円</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="操作" Sortable="false">
                        <CellTemplate>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenDeleteDialog(context.Item))" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Class="mt-4">購入履歴がありません</MudAlert>
        }
    </MudContainer>
}

<MudDialog VIsible="_isDeleteDialogOpen">
    <DialogContent>
        <MudText>この購入記録を削除しますか？</MudText>
        @if (_selectedLog != null)
        {
            <MudText Typo="Typo.body2" Class="mt-2">
                商品: @GetProductName(_selectedLog.ProductId)<br />
                数量: @_selectedLog.Amount 個<br />
                購入日: @_selectedLog.PurchaseDate.ToString("yyyy/MM/dd HH:mm:ss")
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _isDeleteDialogOpen = false)">キャンセル</MudButton>
        <MudButton Color="Color.Error" OnClick="DeletePurchase">削除</MudButton>
    </DialogActions>
</MudDialog>
