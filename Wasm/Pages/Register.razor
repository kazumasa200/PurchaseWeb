@page "/register"
@implements IDisposable

<PageTitle>購入レジ</PageTitle>

@if (IsLoading)
{
    <MudContainer Class="d-flex justify-center align-center" Style="min-height: 50vh;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </MudContainer>
}
else if (!UserState.IsStoreUser)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">ログインしてください</MudText>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth OnClick="NavigateToLogin">ログイン</MudButton>
        </MudPaper>
    </MudContainer>
}
else if (!UserState.HasTenant)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">テナントを選択してください</MudText>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth OnClick="NavigateToLogin">テナント選択</MudButton>
        </MudPaper>
    </MudContainer>
}
else
{
    <div class="d-flex gap-2 mb-3 mt-2">
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.QrCode2"
                   OnClick="ShowPreOrderQr">
            事前注文用QR
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.QrCodeScanner"
                   OnClick="OpenQrScanner">
            QR読み取り
        </MudButton>
    </div>

    <MudGrid Spacing="2">
        @foreach (var item in Products)
        {
            <MudItem @key="item.Product.ProductId" xs="6" sm="4" md="3">
                <MudPaper Class="pa-2 d-flex flex-column align-center" Style="height:100%;" Elevation="2">
                    @if (!IsImageLoaded(item.Product.ProductId))
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="120px" Height="120px" Style="border-radius:8px;" />
                    }
                    else if (GetProductImageSrc(item.Product.ProductId) is string src)
                    {
                        <img src="@src" alt="@item.Product.ProductName"
                             style="width:120px; height:120px; object-fit:cover; border-radius:8px;" />
                    }
                    else
                    {
                        <div style="width:120px;height:120px;display:flex;align-items:center;justify-content:center;background:#f5f5f5;border-radius:8px;">
                            <MudIcon Icon="@Icons.Material.Filled.Image" Style="font-size:60px;" Color="Color.Default" />
                        </div>
                    }

                    <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1 mb-0" Style="line-height:1.3;">
                        @item.Product.ProductName
                    </MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                        ¥@item.Product.Price
                    </MudText>
                    <MudText Typo="Typo.caption" Align="Align.Center"
                             Color="@GetStockColor(item.Product.StockQuantity)">
                        @GetStockText(item.Product.StockQuantity)
                    </MudText>

                    <div class="d-flex align-center justify-center mt-1" style="gap:4px;">
                        <MudIconButton Icon="@Icons.Material.Filled.RemoveCircle"
                                       Size="Size.Large"
                                       Color="@(item.Amount > 0 ? Color.Error : Color.Default)"
                                       Disabled="@(item.Amount <= 0)"
                                       OnClick="@(() => OnAmountChanged(item, item.Amount - 1))" />
                        <MudText Typo="Typo.h6" Style="min-width:2ch; text-align:center;">@item.Amount</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircle"
                                       Size="Size.Large"
                                       Color="Color.Primary"
                                       Disabled="@(item.Amount >= 99)"
                                       OnClick="@(() => OnAmountChanged(item, item.Amount + 1))" />
                    </div>

                    @if (item.Amount > 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Primary" Align="Align.Center">
                            @item.Sum 円
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudPaper Class="ma-2 pa-3 mt-3">
        <MudText Typo="Typo.h5">合計 : @TotalSum 円</MudText>
        <MudNumericField @bind-Value="Received" Min="0" Label="お預かり" Variant="Variant.Outlined" Class="my-2" />
        <MudText Typo="Typo.h5" Class="mb-2">おつり : @(Received - TotalSum) 円</MudText>
        <MudButton Color="Color.Primary" OnClick="@Purchase" Variant="Variant.Filled" Size="Size.Large" FullWidth>
            購買情報登録
        </MudButton>
    </MudPaper>
}
