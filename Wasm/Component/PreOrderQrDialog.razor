@using PurchaseWeb.Wasm.Services
@inherits MudComponentBase

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-4">
            このQRコードをお客様に読み取っていただくと<br />事前注文画面に進めます
        </MudText>

        <div class="d-flex justify-center mb-4">
            @if (!string.IsNullOrEmpty(QrCodeBase64))
            {
                <img src="@($"data:image/png;base64,{QrCodeBase64}")"
                     alt="事前注文QR"
                     style="width: 220px; height: 220px;" />
            }
            else if (_failed)
            {
                <MudText Color="Color.Error">QRコードの生成に失敗しました</MudText>
            }
            else
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            }
        </div>

        <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary">
            @PreOrderUrl
        </MudText>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled" OnClick="() => MudDialog.Cancel()">閉じる</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public string PreOrderUrl { get; set; } = string.Empty;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Inject]
    private QrCodeService QrService { get; set; } = default!;

    private string? QrCodeBase64 { get; set; }
    private bool _failed;

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(PreOrderUrl)) return;

        try
        {
            QrCodeBase64 = QrService.GenerateQrBase64(PreOrderUrl);
        }
        catch (Exception ex)
        {
            _failed = true;
            Console.WriteLine($"QR生成エラー: {ex.Message}");
        }
    }
}
