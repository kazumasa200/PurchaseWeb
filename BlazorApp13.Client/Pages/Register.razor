@page "/register"
@implements IDisposable

<PageTitle>購入レジ</PageTitle>

@if (IsLoading)
{
    <MudContainer Class="d-flex justify-center align-center" Style="min-height: 50vh;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </MudContainer>
}
else if (!UserState.IsStoreUser)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">
                ログインしてください
            </MudText>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth OnClick="NavigateToLogin">
                ログイン
            </MudButton>
        </MudPaper>
    </MudContainer>
}
else if (!UserState.HasTenant)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">
                テナントを選択してください
            </MudText>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth OnClick="NavigateToLogin">
                テナント選択
            </MudButton>
        </MudPaper>
    </MudContainer>
}
else
{
    <h1>購入レジ</h1>
    <div class="d-flex gap-2 mb-3">
        <!-- 既存の事前注文用QRボタン -->
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.QrCode2"
                   OnClick="ShowPreOrderQr">
            事前注文用QRを表示
        </MudButton>

        <!-- 追加：QR読み取りボタン -->
        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.QrCodeScanner"
                   OnClick="OpenQrScanner">
            QRコードを読み取る
        </MudButton>
    </div>
    <MudDataGrid Items="@Products" ReadOnly="true"
                 Bordered="true" Dense="true">
        <Columns>
            <TemplateColumn Title="画像">
                <CellTemplate>
                    @if (!IsImageLoaded(context.Item.Product.ProductId))
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="50px" Height="50px" Style="border-radius: 4px;" />
                    }
                    else if (!string.IsNullOrEmpty(GetProductImage(context.Item.Product.ProductId)))
                    {
                        <MudImage Src="@($"data:image;base64,{GetProductImage(context.Item.Product.ProductId)}")"
                                  Alt="@context.Item.Product.ProductName"
                                  Height="50"
                                  Width="50"
                                  ObjectFit="ObjectFit.Cover"
                                  Class="rounded" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Medium" Color="Color.Default" />
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Product.ProductName" Title="商品名" />
            <PropertyColumn Property="x => x.Product.Price" Title="価格" />
            <PropertyColumn Property="x => x.Product.Misc" Title="その他備考" />
            <TemplateColumn Title="購入数">
                <CellTemplate>
                    <MudStack Row>
                        <MudNumericField @bind-Value="context.Item.Amount" Min="0" Max="99" Immediate="true" Label="数量" Variant="Variant.Outlined" />
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="金額">
                <CellTemplate>
                    <MudStack Row>
                        <MudText>@context.Item.Sum 円</MudText>
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>

    <MudPaper Class="ma-2 pa-2">
        <MudText Typo="Typo.h4" Class="d-flex jusify-end">合計 : @Products.Sum(x => x.Sum) 円</MudText>
        <MudNumericField @bind-Value="Received" Min="0" Immediate="true" Label="お預かり" Variant="Variant.Outlined" Class="d-flex jusify-end" />
        <MudText Typo="Typo.h4" Class="d-flex jusify-end">おつり : @(Received - Products.Sum(x => x.Sum)) 円</MudText>
        <MudButton Color="Color.Primary" OnClick="@Purchase" Variant="Variant.Filled">購買情報登録</MudButton>
    </MudPaper>

    <!-- 追加：事前注文用QRボタン -->
    <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
               StartIcon="@Icons.Material.Filled.QrCode2"
               OnClick="ShowPreOrderQr"
               Class="mb-3">
        事前注文用QRを表示
    </MudButton>
}
