@page "/"
@page "/login"

@inject NavigationManager NavigationManager
@inject UserState userState
@inject ITenantRepository tenantRepository
@inject IJSRuntime JSRuntime
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex flex-column align-center justify-center min-vh-100">
    <MudCard Class="pa-6 ma-2" MaxWidth="500px" Style="border-radius: 20px; box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.25);">
        <MudCardHeader>
            <MudText Typo="Typo.h4" Align="Align.Center">ログイン</MudText>
        </MudCardHeader>
        <MudCardContent>
            @if (!userState.IsStoreUser)
            {
                <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-4">
                    パスワードを入力してログインしてください
                </MudText>
                <MudTextField @bind-Value="password" Immediate Label="パスワード" Variant="Variant.Outlined" InputType="InputType.Password" Class="mb-4" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock" />
                <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth OnClick="Logins" Class="mb-4">
                    ログイン
                </MudButton>
            }
            else if (!userState.HasTenant)
            {
                <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-4">
                    テナントを選択してください
                </MudText>
                @if (tenants.Any())
                {
                    <MudSelect @bind-Value="selectedTenantId" Label="テナント" Variant="Variant.Outlined" Class="mb-4">
                        @foreach (var tenant in tenants)
                        {
                            <MudSelectItem Value="@tenant.TenantId">@tenant.TenantName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth OnClick="SelectTenant" Class="mb-4" Disabled="@string.IsNullOrEmpty(selectedTenantId)">
                        選択
                    </MudButton>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-4">テナントが登録されていません</MudAlert>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth OnClick="NavigateToTenantManage" Class="mb-4">
                        テナント管理へ
                    </MudButton>
                }
            }
            else
            {
                <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-4">
                    ログイン成功（テナント: @userState.CurrentTenantName）
                </MudText>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth OnClick="NavigateToProductManage" Class="mb-4">商品管理</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth OnClick="NavigateToRegister" Class="mb-4">購入レジ</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth OnClick="NavigateToPurchaseHistory" Class="mb-4">購入履歴</MudButton>
            }
        </MudCardContent>
        <MudCardActions Class="d-flex justify-center">
            <MudText Typo="Typo.body2" Class="mb-1">または</MudText>
        </MudCardActions>
        <MudCardActions>
            <MudButton Color="Color.Secondary" Variant="Variant.Outlined" FullWidth OnClick="NavigateToChat">
                チャットにアクセスしたい人はこちら
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    private string password = string.Empty;
    private string? selectedTenantId;
    private List<Tenant> tenants = new();
    private bool _initialized = false;

    [Inject]
    public required UserState UserState { get; set; }

    [Inject]
    public required ITenantProvider TenantProvider { get; set; }

    protected override void OnInitialized()
    {
        UserState.OnStateChanged += OnUserStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            // UserStateを初期化（ローカルストレージから読み込み）
            await userState.InitializeAsync();

            if (UserState.HasTenant && !string.IsNullOrEmpty(UserState.CurrentTenantId))
            {
                TenantProvider.SetTenantId(UserState.CurrentTenantId);
            }

            if (userState.IsStoreUser && !userState.HasTenant)
            {
                await LoadTenants();
            }

            _initialized = true;
            StateHasChanged();
        }
    }

    private async void OnUserStateChanged()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"OnUserStateChanged error: {ex.Message}");
        }
    }

    private async Task LoadTenants()
    {
        try
        {
            tenants = await tenantRepository.GetActiveTenantsAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"LoadTenants error: {ex.Message}");
            tenants = [];
        }
    }

    private async Task Logins()
    {
        await userState.SetStoreUserAsync(password);
        password = string.Empty;

        if (userState.IsStoreUser)
        {
            await LoadTenants();
            StateHasChanged();
        }
    }

    private async Task SelectTenant()
    {
        if (!string.IsNullOrEmpty(selectedTenantId))
        {
            var tenant = tenants.FirstOrDefault(t => t.TenantId == selectedTenantId);
            if (tenant != null)
            {
                await userState.SetTenantAsync(tenant.TenantId, tenant.TenantName);
                StateHasChanged();
            }
        }
    }

    private void NavigateToChat()
    {
        NavigationManager.NavigateTo("/chat");
    }

    private void NavigateToProductManage()
    {
        NavigationManager.NavigateTo("/productmanage");
    }

    private void NavigateToRegister()
    {
        NavigationManager.NavigateTo("/register");
    }

    private void NavigateToPurchaseHistory()
    {
        NavigationManager.NavigateTo("/purchasehistory");
    }

    private void NavigateToTenantManage()
    {
        NavigationManager.NavigateTo("/tenantmanage");
    }

    public void Dispose()
    {
        UserState.OnStateChanged -= OnUserStateChanged;
    }
}
