@using MudBlazor
@using QRCoder
@inherits MudComponentBase

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-4">
            このQRコードをお客様に読み取っていただくと<br />事前注文画面に進めます
        </MudText>

        <div class="d-flex justify-center mb-4">
            @if (!string.IsNullOrEmpty(QrCodeBase64))
            {
                <img src="@($"data:image/png;base64,{QrCodeBase64}")"
                     alt="事前注文QR"
                     style="width: 220px; height: 220px;" />
            }
        </div>

        <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary">
            @PreOrderUrl
        </MudText>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled" OnClick="() => MudDialog.Cancel()">閉じる</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public string PreOrderUrl { get; set; } = string.Empty;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private string? QrCodeBase64 { get; set; }

    protected override void OnInitialized()
    {
        GenerateQr();
    }

    private void GenerateQr()
    {
        if (string.IsNullOrEmpty(PreOrderUrl)) return;

        using var qrGenerator = new QRCodeGenerator();
        using var qrCodeData = qrGenerator.CreateQrCode(PreOrderUrl, QRCodeGenerator.ECCLevel.M);
        using var qrCode = new PngByteQRCode(qrCodeData);
        var bytes = qrCode.GetGraphic(10);
        QrCodeBase64 = Convert.ToBase64String(bytes);
    }
}
