@using Infra.Persistance.Entities
@using Infra.Repositories
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@inherits MudComponentBase

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">@(IsNew ? "新規商品登録" : "商品編集")</MudText>

        <MudTextField @bind-Value="FormProductName" Label="商品名 *" Variant="Variant.Outlined"
                      FullWidth="true" Required="true" Class="mb-3" />

        <MudNumericField @bind-Value="FormPrice" Label="価格 *" Variant="Variant.Outlined"
                         Min="0" Class="mb-3" />

        <MudNumericField @bind-Value="FormStockQuantity" Label="在庫数（空白=無制限）"
                         Variant="Variant.Outlined" Min="0" Clearable="true" Class="mb-3" />

        <MudTextField @bind-Value="FormMisc" Label="その他備考" Variant="Variant.Outlined"
                      FullWidth="true" Class="mb-3" />

        <!-- 画像アップロード -->
        <MudPaper Class="pa-3" Outlined="true">
            <div class="text-center">
                @if (!string.IsNullOrEmpty(FormImageBase64))
                {
                    <div class="mb-3">
                        <MudImage Src="@($"data:image;base64,{FormImageBase64}")" Alt="プレビュー"
                                  Height="120" ObjectFit="ObjectFit.Contain" />
                        <div class="d-flex justify-center mt-2">
                            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       OnClick="() => FormImageBase64 = null">
                                画像を削除
                            </MudButton>
                        </div>
                    </div>
                }

                <InputFile OnChange="OnFileSelected" Accept="image/*" Style="display: none;" Id="fileInputDialog" />
                <MudButton HtmlTag="label" for="fileInputDialog" Variant="Variant.Filled"
                           Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">
                    画像を選択
                </MudButton>
                <div class="text-center text-caption mt-2">最大 5MB</div>
            </div>
        </MudPaper>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CancelDialog">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveProduct">
            @(IsNew ? "登録" : "更新")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public Product? Product { get; set; }

    [Inject]
    private ISnackbar Snackbar { get; set; } = default!;

    [Inject]
    private IProductRepository ProductRepository { get; set; } = default!;

    // ← ここが修正ポイント
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private string FormProductName { get; set; } = string.Empty;
    private int FormPrice { get; set; }
    private int? FormStockQuantity { get; set; }
    private string FormMisc { get; set; } = string.Empty;
    private string? FormImageBase64 { get; set; }

    protected override void OnInitialized()
    {
        if (!IsNew && Product != null)
        {
            FormProductName = Product.ProductName;
            FormPrice = Product.Price;
            FormStockQuantity = Product.StockQuantity;
            FormMisc = Product.Misc ?? string.Empty;
            FormImageBase64 = Product.ImageBase64;
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        var maxFileSize = 5 * 1024 * 1024;

        if (file.Size > maxFileSize)
        {
            Snackbar.Add("ファイルサイズは 5MB 以下にしてください", Severity.Error);
            return;
        }

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxFileSize).CopyToAsync(ms);
            FormImageBase64 = Convert.ToBase64String(ms.ToArray());
            Snackbar.Add("画像をアップロードしました", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"画像アップロードエラー：{ex.Message}", Severity.Error);
            FormImageBase64 = null;
        }
    }

    private void CancelDialog()
    {
        MudDialog.Cancel();
    }

    private async Task SaveProduct()
    {
        if (string.IsNullOrWhiteSpace(FormProductName))
        {
            Snackbar.Add("商品名は必須です", Severity.Warning);
            return;
        }

        if (FormPrice <= 0)
        {
            Snackbar.Add("価格は 1 円以上にしてください", Severity.Warning);
            return;
        }

        try
        {
            if (IsNew)
            {
                var product = Product.Create(null, FormProductName, FormPrice, FormMisc, FormImageBase64, FormStockQuantity);
                var result = await ProductRepository.AddAsync(product);

                if (result.IsSuccess)
                {
                    Snackbar.Add("商品を登録しました", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                {
                    Snackbar.Add($"登録エラー：{result.ErrorMessage}", Severity.Error);
                }
            }
            else
            {
                if (Product != null)
                {
                    Product.ProductName = FormProductName;
                    Product.Price = FormPrice;
                    Product.StockQuantity = FormStockQuantity;
                    Product.Misc = string.IsNullOrEmpty(FormMisc) ? null : FormMisc;
                    Product.ImageBase64 = string.IsNullOrEmpty(FormImageBase64) ? null : FormImageBase64;

                    var result = await ProductRepository.UpdateAsync(Product);

                    if (result.IsSuccess)
                    {
                        Snackbar.Add("商品を更新しました", Severity.Success);
                        MudDialog.Close(DialogResult.Ok(true));
                    }
                    else
                    {
                        Snackbar.Add($"更新エラー：{result.ErrorMessage}", Severity.Error);
                    }
                }
                else
                {
                    Snackbar.Add("編集対象の商品が見つかりません", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"エラーが発生しました：{ex.Message}", Severity.Error);
        }
    }
}
