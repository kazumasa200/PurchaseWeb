@using PurchaseWeb.Component
@inherits LayoutComponentBase
@inject NavigationManager navigationManager

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>noeleve.net</PageTitle>

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudSpacer />
        <ArchitectureInfo />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2">
        <MudDrawerHeader>
            <MudText Typo="Typo.h5" Class="mt-1">Noeleve.net</MudText>
        </MudDrawerHeader>
        <MudDivider Class="pa-2" DividerType="DividerType.Middle"/>
        <NavMenu/>
        <MudSpacer></MudSpacer>
        <MudButton Variant="Variant.Filled"  Color="Color.Primary" OnClick="NavigateToChat">ログイン</MudButton>
    </MudDrawer>
    <MudMainContent Class="px-4">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    void NavigateToChat()
    {
        navigationManager.NavigateTo("/");
    }
}