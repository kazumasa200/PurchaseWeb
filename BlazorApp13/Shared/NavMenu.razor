@using Infra.Repositories
@inject UserState userState
@implements IDisposable

<MudNavMenu>
    @if (userState.IsStoreUser)
    {
        <MudNavLink Href="/productmanage" Match="NavLinkMatch.All">商品管理</MudNavLink>
        <MudNavLink Href="/register" Match="NavLinkMatch.Prefix">購入レジ</MudNavLink>
        <MudNavLink Href="/purchasehistory" Match="NavLinkMatch.Prefix">購入履歴</MudNavLink>
    }
    <MudNavLink Href="/chat" Match="NavLinkMatch.Prefix">AIチャット</MudNavLink>
    <MudNavLink Href="/lottery" Match="NavLinkMatch.Prefix">宝くじシミュレーター</MudNavLink>

</MudNavMenu>

@code {
    protected override void OnInitialized()
    {
        userState.OnStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        userState.OnStateChanged -= StateHasChanged;
    }
}