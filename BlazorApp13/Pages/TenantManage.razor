@page "/tenantmanage"
@using Infra.Persistance.Entities
@using Infra.Repositories
@inject ITenantRepository TenantRepository
@inject UserState UserState
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@implements IDisposable
@rendermode @(new InteractiveServerRenderMode())

<PageTitle>テナント管理</PageTitle>

@if (UserState.IsStoreUser)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
        <MudText Typo="Typo.h4" Class="mb-4">テナント管理</MudText>

        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenAddDialog" StartIcon="@Icons.Material.Filled.Add" Class="mb-4">
            新規テナント追加
        </MudButton>

        <MudDataGrid Items="@tenants" ReadOnly="false" Bordered="true" Dense="true">
            <Columns>
                <PropertyColumn Property="x => x.TenantName" Title="テナント名" />
                <PropertyColumn Property="x => x.CreateDate" Title="作成日" Format="yyyy/MM/dd HH:mm" />
                <PropertyColumn Property="x => x.UpdateDate" Title="更新日" Format="yyyy/MM/dd HH:mm" />
                <TemplateColumn Title="操作">
                    <CellTemplate>
                        <MudStack Row>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditDialog(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => OpenDeleteDialog(context.Item))" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudContainer>
}
else
{
    <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-4">
        ログインしてください
    </MudText>
    <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth OnClick="NavigateToLogin" Class="mb-4">
        ログイン
    </MudButton>
}

@code {
    private List<Tenant> tenants = new();
    private bool isAddDialogOpen = false;
    private bool isEditDialogOpen = false;
    private bool isDeleteDialogOpen = false;
    private Tenant? selectedTenant;
    private string tenantName = string.Empty;

    [Inject]
    public required ITenantProvider TenantProvider { get; set; }

    protected override void OnInitialized()
    {
        UserState.OnStateChanged += OnUserStateChanged;
    }

    private void OpenAddDialog()
    {
        tenantName = string.Empty;
        isAddDialogOpen = true;
    }

    private void OpenEditDialog(Tenant tenant)
    {
        selectedTenant = tenant;
        tenantName = tenant.TenantName;
        isEditDialogOpen = true;
    }

    private void OpenDeleteDialog(Tenant tenant)
    {
        selectedTenant = tenant;
        isDeleteDialogOpen = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && UserState.IsStoreUser)
        {
            await LoadTenants();
            StateHasChanged();
        }
    }

    private async void OnUserStateChanged()
    {
        await LoadTenants();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadTenants()
    {
        var allTenants = await TenantRepository.GetAllTenantsAsync();
        tenants = allTenants.Where(t => !t.DeleteFlag).ToList();
        StateHasChanged();
    }

    public void Dispose()
    {
        UserState.OnStateChanged -= OnUserStateChanged;
    }

    private async Task AddTenant()
    {
        if (string.IsNullOrWhiteSpace(tenantName))
        {
            Snackbar.Add("テナント名を入力してください", Severity.Warning);
            return;
        }

        var tenant = Tenant.Create(tenantName);
        var result = await TenantRepository.AddAsync(tenant);

        if (result.IsSuccess)
        {
            Snackbar.Add("テナントを追加しました", Severity.Success);
            isAddDialogOpen = false;
            await LoadTenants();
            UserState.NotifyStateChanged();  // ← 追加：MainLayoutに通知
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "エラーが発生しました", Severity.Error);
        }
    }

    private async Task UpdateTenant()
    {
        if (selectedTenant == null || string.IsNullOrWhiteSpace(tenantName))
        {
            Snackbar.Add("テナント名を入力してください", Severity.Warning);
            return;
        }

        var updatedTenant = new Tenant
        {
            TenantId = selectedTenant.TenantId,
            TenantName = tenantName,
            CreateDate = selectedTenant.CreateDate,
            UpdateDate = DateTime.Now,
            DeleteFlag = selectedTenant.DeleteFlag
        };

        var result = await TenantRepository.UpdateAsync(updatedTenant);

        if (result.IsSuccess)
        {
            Snackbar.Add("テナントを更新しました", Severity.Success);
            isEditDialogOpen = false;
            await LoadTenants();
            UserState.NotifyStateChanged();  // ← 追加：MainLayoutに通知
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "エラーが発生しました", Severity.Error);
        }
    }

    private async Task DeleteTenant()
    {
        if (selectedTenant == null) return;

        var deletedTenant = new Tenant
        {
            TenantId = selectedTenant.TenantId,
            TenantName = selectedTenant.TenantName,
            CreateDate = selectedTenant.CreateDate,
            UpdateDate = DateTime.Now,
            DeleteFlag = true
        };

        var result = await TenantRepository.UpdateAsync(deletedTenant);

        if (result.IsSuccess)
        {
            Snackbar.Add("テナントを削除しました", Severity.Success);
            isDeleteDialogOpen = false;
            await LoadTenants();
            UserState.NotifyStateChanged();  // ← 追加：MainLayoutに通知
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "エラーが発生しました", Severity.Error);
        }
    }

    private void NavigateToLogin()
    {
        NavigationManager.NavigateTo("/login");
    }
}

<MudDialog Visible="isAddDialogOpen">
    <DialogContent>
        <MudTextField @bind-Value="tenantName" Label="テナント名" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => isAddDialogOpen = false)">キャンセル</MudButton>
        <MudButton Color="Color.Primary" OnClick="AddTenant">追加</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog Visible="isEditDialogOpen">
    <DialogContent>
        <MudTextField @bind-Value="tenantName" Label="テナント名" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => isEditDialogOpen = false)">キャンセル</MudButton>
        <MudButton Color="Color.Primary" OnClick="UpdateTenant">更新</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog Visible="isDeleteDialogOpen">
    <DialogContent>
        <MudText>本当に「@selectedTenant?.TenantName」を削除しますか？</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => isDeleteDialogOpen = false)">キャンセル</MudButton>
        <MudButton Color="Color.Error" OnClick="DeleteTenant">削除</MudButton>
    </DialogActions>
</MudDialog>
