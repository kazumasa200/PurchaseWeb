{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Launch Project",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "${defaultBuildTask}",
      "program": "${workspaceFolder}/BlazorApp13/bin/Debug/net10.0/PurchaseWeb.dll",
      "args": [],
      "cwd": "${workspaceFolder}/BlazorApp13",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}